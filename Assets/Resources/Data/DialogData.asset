        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_002
        CharacterName: "\uC18C\uC7A5"
        Script: "\uACE7 \uC788\uC73C\uBA74 \uACC4\uC57D\uB3C4 \uB9CC\uB8CC\uB418\uACE0,
          \uACE0\uD5A5\uC73C\uB85C \uB3CC\uC544\uAC08\uD150\uB370\n\uB3CC\uC544\uAC00\uC11C
          \uD560 \uAC70\uB77C\uB3C4 \uC788\uB098."
        NextDialogID: S6_01_003
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_003
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC77C\uB2E8\uC740 \uBCF5\uD559\uD558\uACE0 \uD559\uAD50\uB97C \uACC4\uC18D
