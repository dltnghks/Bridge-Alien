        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: P_01_010
        CharacterName: "\uAC00\uC774\uB4DC"
        Script: "\uC544\uC774\uACE0 \uB450\uC57C\u2026 \uBB54 \uC22B\uC790\uB3C4
