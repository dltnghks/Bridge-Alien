        CharacterName: "\uC18C\uC7A5"
        Script: "\uC608\uC0C1\uC678\uB85C \uD765\uBBF8\uB85C\uC6B4 \uC120\uD0DD\uC744
          \uD588\uB354\uAD70.."
        NextDialogID: S6_03_002
        Type: 2
        SpeakerType: 8
        SpeakerPosType: 2
      - DialogID: S6_03_002
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC800\uB294 \uC870\uC6A9\uD788 \uC788\uACE0 \uC2F6\uB2E4 \uD558\uC600\uC9C0,
          \uD611\uC870\uD558\uACA0\uB2E4\uB294 \uB9D0\uC740 \uD55C \uC801\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
        NextDialogID: S6_03_003
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_03_003
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uADF8\uB807\uB2E4\uACE0 \uC18C\uC7A5\uB2D8\uC744 \uC2E0\uACE0\uD55C\uB2E4\uB294
          \uBA4D\uCCAD\uD55C \uC9D3 \uB610\uD55C \uD560 \uC0DD\uAC01\uC740 \uC5C6\uAD6C\uC694.\n\uC800\uB294
          \uADF8\uB0E5 \uACE0\uD5A5\uC73C\uB85C \uB3CC\uC544\uAC00 \uD3C9\uBC94\uD55C
          \uC77C\uC0C1\uC744 \uC0B4\uACE0 \uC2F6\uC744 \uBFD0\uC785\uB2C8\uB2E4."
        NextDialogID: S6_03_004
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_03_004
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC120\uD0DD\uC5D0 \uB530\uB978 \uCC45\uC784\uB3C4 \uBCF8\uC778\uC774
          \uC9C0\uB294\uAC83\uC77C \uBFD0\uC774\uC9C0.\n\uB0A8\uC740 \uC778\uC0DD\uC744
          \uBC14\uAFC0 \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uB97C \uC2A4\uC2A4\uB85C \uCC28\uBC84\uB9B0
          \uC148\uC774\uC57C."
        NextDialogID: S6_03_005
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03_005
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uADF8\uB7F4\uC9C0\uB3C4 \uBAA8\uB974\uC8E0. \uADF8\uB798\uB3C4
          \uC804 \uD6C4\uD68C\uD558\uC9C0\uC54A\uC2B5\uB2C8\uB2E4."
        NextDialogID: S6_03_006
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_03_006
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "...\uADF8\uB3D9\uC548 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4."
        NextDialogID: End
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: End
        CharacterName: End
        Script: End
        NextDialogID: End
