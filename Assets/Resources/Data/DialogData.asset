    - Key: 28
      Value:
      - DialogID: S6_03B_001
        CharacterName: "\uC18C\uC7A5"
        Script: "\uD558\uD558 \uC7AC\uBC0C\uAD70 \uC5ED\uC2DC \uC7AC\uBC0C\uC5B4.
          \uC790\uB124\uB77C\uBA74 \uC774\uB7F0 \uC120\uD0DD\uC744 \uD560 \uC904
          \uC54C\uC558\uB2E4\uB2C8\uAE50."
        NextDialogID: S6_03B_002
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_002
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uADF8\uB7FC \uC800\uB294 \uC774\uC81C \uC5B4\uB5BB\uAC8C \uB418\uB294\uAC81\uB2C8\uAE4C."
        NextDialogID: S6_03B_003
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_03B_003
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC790\uB124\uAC00 \uC6D0\uD55C\uB2E4\uBA74 \uC6B0\uB9AC \uC870\uC9C1\uC758
          \uACAC\uC2B5\uC73C\uB85C \uBC1B\uC544\uC8FC\uB3C4\uB85D\uD558\uC9C0.\n
          \uB2C8\uAC00 \uBC1B\uB358 \uAE09\uC5EC\uC758 \uC218\uBC31\uBC30\uB294 \uC871\uD788
          \uBC8C \uC218 \uC788\uC744\uAC70\uC57C."
        NextDialogID: S6_03B_004
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_004
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uADFC\uB370 \uC81C \uCDE8\uC5C5\uBE44\uC790\uB294 \uB0B4\uC77C
          \uB9CC\uB8CC\uC778\uB370, \uC5F0\uC7A5 \uC2B9\uC778 \uD558\uAE30\uC5D4
          \uC774\uBBF8 \uAE30\uAC04\uC774 \uC9C0\uB0AC\uC2B5\uB2C8\uB2E4."
        NextDialogID: S6_03B_005
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_03B_005
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8\uAC74 \uB0B4\uAC00 \uC54C\uC544\uC11C \uCC98\uB9AC\uD558\uB3C4\uB85D\uD558\uC9C0."
        NextDialogID: S6_03B_006
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_006
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC77C\uB2E8 \uC2E0\uD300\uC7A5\uC5D0\uAC8C \uC790\uC138\uD55C \uC0AC\uD56D\uB4E4\uC740
          \uC778\uC218\uC778\uACC4 \uBC1B\uB3C4\uB85D\uD574"
        NextDialogID: S6_03B_007
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_007
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC2E0\uD300\uC7A5\uB2D8\uC774\uC694..? \uADF8\uB807\uB2E4\uBA74
          \uC2E0\uD300\uC7A5\uB2D8\uB3C4 \u2026"
        NextDialogID: S6_03B_008
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_03B_008
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC2E0\uD300\uC7A5\uB3C4 \uBC8C\uC368 10\uB144\uC774 \uB118\uC5C8\uC9C0.\n
          \uB108\uB791\uC740 \uCF00\uC774\uC2A4\uAC00 \uC880 \uB2E4\uB974\uC9C0\uB9CC
          \uB9D0\uC774\uC57C"
        NextDialogID: S6_03B_009
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_009
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC544\uBB34\uD2BC \uBE68\uB9AC \uAC00\uBCF4\uB3C4\uB85D\uD574.
          \uC774\uBC88\uC8FC\uB294 \uBB3C\uB7C9\uC774 \uC880 \uB9CE\uC544\uC11C \uB9D0\uC774\uC57C."
        NextDialogID: S6_03B_010
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S6_03B_010
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB135 \uC54C\uACA0\uC2B5\uB2C8\uB2E4."
        NextDialogID: End
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: End
        CharacterName: End
        Script: End
        NextDialogID: End
        Type: 4
        SpeakerType: 0
        SpeakerPosType: 0
    - Key: 29
      Value:
      - DialogID: S6_04B_001
        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uC18C\uC7A5\uB2D8\uD55C\uD14C \uC804\uB2EC \uBC1B\uC558\uB2E4.\n
          \uBC14\uC058\uB2C8 \uBE60\uB974\uAC8C \uC804\uB2EC\uD558\uB3C4\uB85D \uD558\uC9C0."
        NextDialogID: S6_04B_002
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_04B_002
        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uC77C\uB2E8 \uAE30\uBCF8\uC801\uC73C\uB85C \uB108\uB294 \uBC30\uC1A1
          \uC5C5\uBB34\uB97C \uB9E1\uC744\uAC70\uC57C."
        NextDialogID: S6_04B_003
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_04B_003
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uBC30\uC1A1\uC774\uB77C\uBA74..?"
        NextDialogID: S6_04B_004
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_04B_004
        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uBB3C\uAC74\uB4E4\uC744 \uB2E8\uC21C\uD788 \uB2E4\uB978 \uD0DD\uBC30\uB791
          \uAC19\uC774 \uBC30\uC1A1\uD560\uB9AC\uAC00 \uC5C6\uC796\uC544?\n \uBB3C\uAC74
          \uD558\uB098\uD558\uB098 \uC6B0\uB9AC\uAC00 \uC9C1\uC811 \uBC30\uC1A1\uD55C\uB2E4."
        NextDialogID: S6_04B_005
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_04B_005
        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uC77C\uB2E8 \uD45C\uBA74\uC801\uC73C\uB85C \uC6B0\uB9B0 \uBB3C\uB958\uD68C\uC0AC\uB2C8
          \uD3C9\uC2DC\uC5D0\uB294 \uD558\uB358 \uC5C5\uBB34\uB97C \uC774\uC5B4\uC11C\uD558\uACE0,
          \uD1F4\uADFC\uD6C4 \uB124\uAC00 \uB530\uB85C \uBB3C\uAC74\uB4E4\uC744 \uBC30\uC1A1\uD574\uC57C\uD574."
        NextDialogID: S6_04B_006
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_04B_006
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB530\uB978 \uC8FC\uC758\uC0AC\uD56D \uAC19\uC740\uAC74 \uC5C6\uC744\uAE4C\uC694?"
        NextDialogID: S6_04B_007
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S6_04B_007
        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uC77C\uB2E8 \uCCAB \uC8FC\uBB38\uC790\uB294 \uBC30\uC1A1\uC644\uB8CC
          \uC804\uC5D0 \uC0AC\uC804 \uAC80\uC99D\uC791\uC5C5\uC744 \uD574\uC57C\uD574.\n\uAD00\uB828
          \uBA54\uB274\uC5BC\uC740 \uB0B4\uAC00 \uB530\uB85C \uC815\uB9AC\uD574\uB458\uD14C\uB2C8
          \uC774\uB530 \uD1F4\uADFC\uC804\uC5D0 \uBC1B\uC544\uAC00."
        NextDialogID: S6_04B_008
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_04B_008
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB135 \uC54C\uACA0\uC2B5\uB2C8\uB2E4."
        NextDialogID: End
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: End
        CharacterName: End
        Script: End
        NextDialogID: End
        Type: 4
        SpeakerType: 0
        SpeakerPosType: 0
    - Key: 30
      Value:
      - DialogID: E_A_01_001
        CharacterName: 
        Script: "\uD06C\uB85C\uB178\uC2A4 \uC870\uC9C1\uC5D0 \uD569\uB958\uD55C \uAE40\uC774\uBBFC\uC740
          \uACE0\uAC1D \uC720\uCE58\uC640 \uAC1C\uC778\uBC30\uC1A1 \uC5C5\uBB34\uB97C
          \uB9E1\uAC8C\uB418\uC5C8\uB2E4."
        NextDialogID: E_A_01_002
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_002
        CharacterName: 
        Script: "\uADF8\uB294 \uC774 \uC77C\uC774 \uBC94\uC8C4\uB77C\uB294 \uC0AC\uC2E4\uC744
          \uC54C\uACE0 \uC788\uC5C8\uB2E4. \n \uCC98\uC74C\uBD80\uD130, \uBD84\uBA85\uD558\uAC8C"
        NextDialogID: E_A_01_003
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_003
        CharacterName: 
        Script: "\uADF8\uB7EC\uB098 \uAE40\uC774\uBBFC\uC740 \uB9DD\uC124\uC774\uC9C0
          \uC54A\uACE0 \uBE60\uB974\uAC8C \uC870\uC9C1 \uC0DD\uD65C\uC5D0 \uC801\uC751\uD574\uB098\uAC14\uB2E4."
        NextDialogID: E_A_01_004
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_004
        CharacterName: 
        Script: "\uADF8\uB294 \uC7A0\uC7AC \uACE0\uAC1D\uB4E4\uC758 \uAE30\uB85D\uC744
          \uC870\uC0AC\uD588\uB2E4.\n \uC138\uAE08 \uB204\uB77D, \uBD88\uBC95 \uAC1C\uC870,
          \uD5C8\uAC00\uB418\uC9C0 \uC54A\uC740 \uAC70\uB798 \uB0B4\uC5ED.\n \uACF5\uAC1C\uB418\uBA74
          \uACE4\uB780\uD574\uC9C8 \uC815\uBCF4\uB4E4."
        NextDialogID: E_A_01_005
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_005
        CharacterName: 
        Script: "\uC2E0\uACE0\uD558\uC9C0 \uBABB\uD560 \uC774\uC720\uAC00 \uC788\uB294
          \uC0AC\uB78C\uB4E4, \uADF8\uB4E4\uC774 \uADF8\uC758 \uC2DC\uC7A5\uC774\uC5C8\uB2E4.\n
          \uAE40\uC774\uBBFC\uC740 \uADF8\uB4E4\uC758 \uC0C1\uD669\uC744 \uD30C\uC545\uD588\uACE0,
          \uD544\uC694\uD55C \uBB3C\uAC74\uC744 \uC815\uD655\uD788 \uC81C\uC2DC\uD588\uB2E4."
        NextDialogID: E_A_01_006
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_006
        CharacterName: 
        Script: "\uCCAB\uB2EC \uC2E0\uADDC \uACE0\uAC1D 11\uBA85,\n \uC11D\uB2EC\uC9F8\uC5D0
          49\uBA85,\n \uBD84\uAE30 \uB9E4\uCD9C 318% \uC99D\uAC00"
        NextDialogID: E_A_01_007
        Type: 2
        SpeakerType: 13
        SpeakerPosType: 3
      - DialogID: E_A_01_007
        CharacterName: 
        Script: "\uC2DC\uC7A5\uC5D0\uB294 \uCD9C\uCC98\uB97C \uC54C \uC218 \uC5C6\uB294
          \uBB3C\uD488\uC774 \uC810\uC810 \uB298\uC5B4\uB0AC\uB2E4.\n \uADF8\uC640
          \uB3D9\uC2DC\uC5D0 \uAE40\uC774\uBBFC\uC758 \uACC4\uC88C\uB3C4 \uD568\uAED8
          \uBD88\uC5B4\uB0AC\uB2E4."
        NextDialogID: E_A_01_008
        Type: 2
        SpeakerType: 13
        SpeakerPosType: 3
      - DialogID: E_A_01_008
        CharacterName: 
        Script: "\uADF8\uB294 \uB3CC\uC544\uAC00\uC9C0 \uC54A\uC558\uB2E4.\n \uC560\uCD08\uC5D0
          \uADF8\uB7F4\uD544\uC694\uAC00 \uC5C6\uC5C8\uB2E4. \uC774\uACF3\uC740 \uB354
          \uC774\uC0C1 \uD0C0\uC9C0\uAC00 \uC544\uB2C8\uB2C8\uAE50"
        NextDialogID: E_A_01_009
        Type: 2
        SpeakerType: 13
        SpeakerPosType: 3
      - DialogID: E_A_01_009
        CharacterName: 
        Script: "\uAE40\uC774\uBBFC\uC5D0\uAC8C \uC788\uC5B4 \uC9C0\uAD6C\uB294 \uC774\uC81C
          \uAC00\uC7A5 \uC548\uC815\uC801\uC778 \uC9C1\uC7A5\uC774\uC790 \uACE0\uD5A5\uC774
          \uB418\uC5C8\uB2E4."
        NextDialogID: End
        Type: 4
        SpeakerType: 13
        SpeakerPosType: 3
      - DialogID: End
        CharacterName: End
        Script: End
        NextDialogID: End
        Type: 4
        SpeakerType: 0
        SpeakerPosType: 0
