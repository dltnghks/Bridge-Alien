      - DialogID: S6_02_003
        CharacterName: "\uC18C\uC7A5"
        Script: "\uB0B4\uC77C 3\uC791\uC5C5\uC7A5\uC5D0 \uD1B5\uD574\uC11C \uB4E4\uC5B4\uC624\uB294
