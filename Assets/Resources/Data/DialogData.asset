        NextDialogID: S6_01_004
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_004
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC5EC\uAE30\uC640\uC11C \uACA8\uC6B0 \uB4F1\uB85D\uAE08 \uC815\uB3C4\uB9CC
          \uBC88 \uAC83 \uAC19\uC740\uB370,\n\uBD80\uBAA8\uB2D8 \uC8FC\uC720\uC18C\uB3C4
          \uB9DD\uD588\uB2E4\uACE0 \uB4E4\uC5C8\uACE0."
        NextDialogID: S6_01_005
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_005
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\u2026"
        NextDialogID: S6_01_006
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_006
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC878\uC5C5\uD55C\uB2E4 \uD574\uB3C4 \uAE30\uAECF\uD574\uC57C \uD47C\uB3C8\uC774\uB098
          \uB9CC\uC9C8\uD150\uB370.\n\uAC00\uC871\uB4E4 \uC785\uC5D0 \uD480\uCE60\uC774\uB098
          \uC81C\uB300\uB85C \uD558\uACA0\uC5B4?"
        NextDialogID: S6_01_007
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_007
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\u2026"
        NextDialogID: S6_01_008
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_008
        CharacterName: "\uC18C\uC7A5"
        Script: "\uD2B9\uBCC4\uD788 \uB0B4\uAC00 \uC790\uB124\uC5D0\uAC8C \uC120\uD0DD\uAD8C\uC744
          \uC8FC\uC9C0.\n\uB0B4\uC77C 3\uBC88 \uC791\uC5C5\uC7A5\uC744 \uD1B5\uD574\uC11C
          \uBB3C\uAC74\uB4E4\uC774 \uB4E4\uC5B4\uC62C\uAC70\uC57C."
        NextDialogID: S6_01_009
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_009
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uBB3C\uAC74\uB4E4\uC774\uB77C\uB2C8.. \uC5B4\uB5A4..?"
        NextDialogID: S6_01_010
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_010
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC6B0\uB9AC \uC870\uC9C1\uC5D0\uC11C \uC720\uD1B5\uD558\uB294 \uBB3C\uAC74\uB9D0\uC774\uC57C.\n\uC5B4\uB5A4
          \uBB3C\uAC74\uC778\uC9C0\uB294 \uC54C \uD544\uC694\uC5C6\uC5B4."
        NextDialogID: S6_01_011
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_011
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8 \uD0DD\uBC30\uB4E4\uC740 \uBC30\uC1A1\uBC88\uD638\uC758 \uC54C\uD30C\uBCB3\uC774
          CHR \uC774\uB77C\uB294 \uD0DC\uADF8\uB85C \uC2DC\uC791\uB420\uAC70\uC57C.\n\uBC18\uB4DC\uC2DC
          \uADF8 \uBB3C\uAC74\uB4E4\uC740 \uC791\uC5C5\uC7A5 \uD558\uB2E8\uC5D0 \uC704\uCE58\uD55C
          \uCC28\uB7C9\uC5D0 \uC62E\uAE30\uB3C4\uB85D\uD574."
        NextDialogID: S6_01_012
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_012
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC81C\uAC00 \uC65C \uADF8\uB798\uC57C \uD558\uB294\uAC83\uC774\uC8E0..?"
        NextDialogID: S6_01_013
        Type: 2
        SpeakerType: 3
        SpeakerPosType: 2
      - DialogID: S6_01_013
        CharacterName: "\uC18C\uC7A5"
        Script: "\uAC15\uC694 \uB530\uC708 \uC5C6\uC5B4.\n\uC790\uB124\uC5D0\uAC8C
          \uC120\uD0DD\uAD8C\uC744 \uC8FC\uB294\uAC83\uC77C \uBFD0\uC774\uC57C"
        NextDialogID: S6_01_014
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_014
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC790\uB124\uAC00 \uACFC\uC5C5\uC744 \uBB34\uC0AC\uD788 \uC218\uD589\uD55C\uB2E4\uBA74
          \n\uC6B0\uB9AC\uC640 \uD568\uAED8\uD560 \uC218 \uC788\uB294 \uCD5C\uC18C\uD55C\uC758
          \uC2E0\uB8B0\uB97C \uC5BB\uC744 \uC218 \uC788\uACA0\uC9C0."
        NextDialogID: S6_01_015
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 1
      - DialogID: S6_01_015
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB9CC\uC77C \uD558\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD558\uBA74\uC694..?"
        NextDialogID: S6_01_016
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 2
      - DialogID: S6_01_016
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8\uC5D0\uB530\uB978 \uCC45\uC784\uB3C4 \uC790\uB124\uAC00 \uC9C0\uB294\uAC83\uC774\uC9C0.\n\uBA85\uC2EC\uD558\uB3C4\uB85D\uD574
          \uC120\uD0DD\uC740 \uC790\uC720\uB77C\uACE0"
        NextDialogID: S6_01_017
