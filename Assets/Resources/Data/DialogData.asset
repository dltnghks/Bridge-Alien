    - Key: 27
      Value:
      - DialogID: E_A_01_001
        CharacterName: 
        Script: "\uB124\uC774\uC624\uC2A4\uC5D0 \uB3C4\uCC29\uD55C \uC655\uBCF5\uC120\uC5D0\uC11C
          \uAE40\uC774\uBBFC\uC758 \uBAA8\uC2B5\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
        NextDialogID: E_A_01_002
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_002
        CharacterName: 
        Script: "\uACE7 \uAE40\uC774\uBBFC\uC5D0 \uB300\uD55C \uC2E4\uC885 \uC2E0\uACE0\uAC00
          \uC811\uC218\uB418\uC5C8\uACE0,\n \uC9C0\uAD6C \uC815\uAC70\uC7A5\uC5D0
          \uB369\uADF8\uB7EC\uB2C8 \uB0A8\uACA8\uC9C4 \uADF8\uC758 \uC218\uD654\uBB3C\uC774
          \uBC1C\uACAC\uB418\uC5C8\uB2E4."
        NextDialogID: E_A_01_003
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_003
        CharacterName: 
        Script: "\uADF8 \uC548\uC5D0\uB294 \uB2E4\uC218\uC758 \uB9C8\uC57D\uB958\uC640
          \uBE44\uC778\uAC00 \uC7A5\uCE58\uB4E4\uC774 \uBC1C\uACAC\uB418\uC5C8\uACE0,\n
          \uACBD\uCC30\uC740 \uCD5C\uADFC \uD655\uC0B0\uB418\uACE0 \uC788\uB358 \uBD88\uBC95
          \uBC00\uC218\uD488 \uC720\uD1B5\uC758 \uBC30\uD6C4\uB85C \uAE40\uC774\uBBFC\uC744
          \uC9C0\uBAA9\uD558\uC600\uB2E4."
        NextDialogID: E_A_01_004
        Type: 2
        SpeakerType: 0
        SpeakerPosType: 0
      - DialogID: E_A_01_004
        CharacterName: 
        Script: "(\uCD5C\uADFC \uD655\uC0B0\uB418\uACE0 \uC788\uB358 \uBD88\uBC95
          \uBC00\uC218\uD488 \uC720\uD1B5\uC758 \uBC30\uD6C4\uAC00 \uD3C9\uBC94\uD55C
          \uB300\uD559\uC0DD \uAE40\uBAA8\uC528\uB85C \uBC1D\uD600\uC838 \uCDA9\uACA9\uC744
          \uC8FC\uACE0\uC788\uB294 \uAC00\uC6B4\uB370,)"
        NextDialogID: E_A_01_005
        Type: 2
        SpeakerType: 12
        SpeakerPosType: 3
      - DialogID: E_A_01_005
        CharacterName: 
        Script: "(\uACBD\uCC30\uC740 \uAE40\uBAA8\uC528\uAC00 \uB3C4\uC8FC\uD558\uC600\uB2E4
          \uD310\uB2E8\uD558\uACE0 \uC804\uAD6D\uC5D0 \uC218\uBC30\uB839\uC744 \uB0B4\uB838\uC2B5\uB2C8\uB2E4.)"
        NextDialogID: E_A_01_006
        Type: 2
        SpeakerType: 12
        SpeakerPosType: 3
      - DialogID: E_A_01_006
        CharacterName: 
        Script: "(\uD55C\uD3B8 \uADF8\uC758 \uB3C4\uC8FC\uB97C \uB3C4\uC6B4 \uAC83\uC73C\uB85C
          \uC54C\uB824\uC838\uC788\uB294 P\uBAA8\uC528\uB294 \uD604\uC7AC \uAD6C\uC18D\uB418\uC5B4
          \uC870\uC0AC\uB97C \uBC1B\uACE0\uC788\uB294 \uC0C1\uD669\uC785\uB2C8\uB2E4...)"
        NextDialogID: End
