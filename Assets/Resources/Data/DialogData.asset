        Type: 1
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: P_01_004
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC798\uC0AC\uB294 \uB3D9\uB124 \uCE58\uACE0\uB294 \uBCC4\uAC8C
