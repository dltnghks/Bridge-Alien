          \uC9C8\uBB38\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\uC5BC\uB9C8\uC804\uC5D0 \uD558\uCC28
          \uC791\uC5C5\uC911 \uAE08\uC9C0\uC57D\uBB3C\uC774 \uD3EC\uD568\uB41C \uD0DD\uBC30\uB97C
          \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
        NextDialogID: S5_05_007
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_007
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uADF8\uB798\uC11C \uBC1C\uC1A1\uC778 \uC815\uBCF4\uB97C \uCC3E\uC544\uBCF4\uC558\uC8E0.\n\uADFC\uB370
          \uBC1C\uC1A1\uC778\uC774 \uCF54\uC2A4\uBAA8 \uBB3C\uB958\uB85C \uB418\uC5B4\uC788\uB124\uC694?\n\uC5B4\uB5BB\uAC8C
          \uB41C\uAC74\uC9C0 \uC124\uBA85\uD574\uC8FC\uC154\uC57C \uD560\uAC83\uAC19\uC2B5\uB2C8\uB2E4."
        NextDialogID: S5_05_008
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_008
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8\uAC8C \uBB34\uC2A8 \uBB38\uC81C\uAC00 \uB418\uB294\uAC70\uC9C0?\n\uB0B4\uAC00
          \uBB3C\uD488\uC744 \uC77C\uC77C\uC774 \uD655\uC778\uD558\uB294 \uAC83\uB3C4
          \uC544\uB2CC\uB370\n\uACE0\uC791 \uD0DD\uBC30 \uD55C \uAC1C \uAC00\uC9C0\uACE0
          \uB0B4 \uCEF4\uD4E8\uD130\uB97C \uBAB0\uB798 \uD6D4\uCCD0\uBD24\uB2E4\uB294
          \uAC74\uAC00?"
        NextDialogID: S5_05_009
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_009
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB2E8\uC21C\uD788 \uD0DD\uBC30\uD55C\uAC1C\uAC00 \uC544\uB2D9\uB2C8\uB2E4.\n\uBD84\uBA85\uD788
          \uBD88\uBC95 \uBC00\uC218\uD488\uC774\uACE0, \uBC94\uC8C4\uC870\uC9C1\uACFC
          \uC5F0\uAD00\uC774 \uB418\uC5B4\uC788\uB2E4\uB294\uAC83\uB3C4 \uC54C\uACE0\uC788\uC2B5\uB2C8\uB2E4."
        NextDialogID: S5_05_010
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_010
        CharacterName: "\uC18C\uC7A5"
        Script: "\uAF64 \uB9CE\uC740\uAC78 \uC54C\uACE0 \uC788\uAD6C\uB9CC."
        NextDialogID: S5_05_011
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_011
        CharacterName: "\uC18C\uC7A5"
        Script: "\uB9DE\uC544, \uADF8\uAC74 \uC6B0\uB9AC \uD06C\uB85C\uB178\uC2A4
          \uC870\uC9C1\uC5D0\uC11C \uC720\uD1B5\uD558\uB294 \uBB3C\uAC74\uC774\uC9C0.\n\uBB3C\uB860
          \uB2F4\uB2F9\uC790\uB294 \uBC14\uB85C \uB098\uACE0."
        NextDialogID: S5_05_012
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_012
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8\uB7F0\uB370, \uADF8\uB798\uC11C \uB108\uAC00 \uBB58 \uD560\uC218
          \uC788\uC9C0?\n\uACBD\uCC30\uC5D0 \uC2E0\uACE0\uB77C\uB3C4 \uD560\uAC74\uAC00?"
        NextDialogID: S5_05_013
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_013
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB4E4\uD0A4\uC2E0\uAC83 \uCE58\uACE0\uB294 \uB2F9\uB2F9\uD558\uC2DC\uB124\uC694"
        NextDialogID: S5_05_014
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_014
        CharacterName: "\uC18C\uC7A5"
        Script: "\uB108\uAC19\uC740 \uC678\uB178\uC790 \uD558\uB098 \uCC98\uB9AC\uD558\uB294
          \uAC74 \uC77C\uB3C4\uC544\uB2C8\uC57C.\n\uB2E8\uC21C\uD788 \uC791\uC5C5\uC911
          \uC0AC\uACE0\uCC98\uB9AC\uB85C \uC601\uC601 \uC774\uC138\uC0C1 \uC0AC\uB78C\uC774
          \uC544\uB2CC\uAC83\uC73C\uB85C\uB3C4 \uB9CC\uB4E4\uC218 \uC788\uC9C0."
        NextDialogID: S5_05_015
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_015
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\u2026"
        NextDialogID: S5_05_016
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_016
        CharacterName: "\uC18C\uC7A5"
        Script: "\uC774\uC81C \uC8FC\uC81C\uD30C\uC545\uC774 \uC880 \uB418\uC5C8\uB098?"
        NextDialogID: S5_05_017
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_017
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC0AC\uC2E4 \uC800\uB294 \uC774\uC77C\uC5D0 \uAD00\uC5EC\uD558\uACE0
          \uC2F6\uC9C0\uC54A\uC2B5\uB2C8\uB2E4\u2026\n\uD3EC\uC0C1\uAE08\uC5D0 \uB208\uC774
          \uBA40\uC5B4 \uC7A0\uC2DC \uC815\uC2E0\uC774 \uB098\uAC14\uB358\uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
        NextDialogID: S5_05_018
        Type: 2
        SpeakerType: 1
        SpeakerPosType: 1
      - DialogID: S5_05_018
        CharacterName: "\uC18C\uC7A5"
        Script: "\uB108\uB294 \uC624\uB298 \uC5EC\uAE30\uC11C \uC544\uBB34\uAC83\uB3C4
          \uBCF4\uC9C0\uBABB\uD55C\uAC70\uC57C.\n\uADF8\uC800 \uC7A5\uB2D8\uCC98\uB7FC
          \uC9C0\uB0B4\uB2E4\uAC00 \uC870\uC6A9\uD788 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uB77C\uACE0"
        NextDialogID: S5_05_019
        Type: 2
        SpeakerType: 7
        SpeakerPosType: 2
      - DialogID: S5_05_019
        CharacterName: "\uC18C\uC7A5"
        Script: "\uADF8\uAC8C \uB108\uD55C\uD14C\uB3C4 \uCD5C\uC120\uC774\uC57C."
        NextDialogID: S5_05_020
        Type: 2
