      - DialogID: P_01_005
        CharacterName: "\uAC00\uC774\uB4DC"
        Script: "\uC790\uC790~ \uB2E4\uB4E4 \uADF8\uB9CC \uB450\uB9AC\uBC88 \uAC70\uB9AC\uC2DC\uACE0\n
