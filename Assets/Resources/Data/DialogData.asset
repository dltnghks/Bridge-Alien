        SpeakerPosType: 0
    - Key: 24
      Value:
      - DialogID: S6_04_001
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uD54C\uD53C \uC5ED\uC2DC \uC6B0\uB9AC \uC0DD\uAC01\uC774 \uB9DE\uC558\uC5B4."
        NextDialogID: S6_04_002
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_002
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC720\uD1B5\uB418\uB294 \uBC00\uC218\uD488\uB4E4\uC740 1\uCC28\uC801\uC73C\uB85C
          \uC18C\uC7A5\uD55C\uD14C \uB4E4\uC5B4\uC628 \uD6C4,\n \uCF54\uC2A4\uBAA8
          \uBB3C\uB958\uB97C \uD1B5\uD574\uC11C \uAC1C\uC778\uB4E4\uC5D0\uAC8C \uBC1C\uC1A1\uD558\uB294
          \uD615\uD0DC\uAC00 \uB9DE\uC544."
        NextDialogID: S6_04_003
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_003
        CharacterName: "\uD54C\uD53C"
        Script: "\uADFC\uB370 \uADF8\uAC78 \uC785\uC99D\uD560 \uC99D\uAC70\uAC00
          \uC5C6\uC796\uC544.\n \uB108\uAC00 \uBCF4\uB0B4\uC92C\uB358 \uC0D8\uD50C\uC740
          \uBC30\uC1A1 \uC815\uBCF4\uB3C4 \uC5C6\uC5C8\uACE0"
        NextDialogID: S6_04_004
        Type: 2
        SpeakerType: 10
        SpeakerPosType: 2
      - DialogID: S6_04_004
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC5B4\uC81C \uC18C\uC7A5\uC774 \uC791\uC5C5\uC7A5\uC744 \uD1B5\uD574\uC11C
          \uB4E4\uC5B4\uC628 \uBB3C\uAC74\uB4E4\uC744 \uB530\uB85C \uC62E\uAE30\uB77C\uB294
          \uC9C0\uC2DC\uB97C \uD588\uC5B4."
        NextDialogID: S6_04_005
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_005
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uB2F9\uC5F0\uD788 \uADF8 \uBB3C\uAC74\uB4E4\uC740 \uBC00\uC218\uD488\uC77C
          \uAC70\uACE0, \uD0DD\uBC30 \uACE0\uC720\uBC88\uD638\uC640 \uBC30\uC1A1\uC9C0
          \uAE4C\uC9C0 \uBAA8\uB450 \uC0AC\uC9C4\uC73C\uB85C \uAE30\uB85D\uD574\uB1A8\uC5B4."
        NextDialogID: S6_04_006
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_006
        CharacterName: "\uD54C\uD53C"
        Script: "\uADF8\uB7FC \uADF8\uB54C \uBCF4\uB0B4\uC900 \uC0D8\uD50C\uC744
          \uBC14\uD0D5\uC73C\uB85C \uC2E0\uACE0\uB97C \uD574\uC11C \uC218\uC0AC\uAC00
          \uC774\uB904\uC9C0\uBA74,\n \uB108\uAC00 \uCC0D\uC5B4\uB193\uC740 \uD0DD\uBC30\uB4E4\uC744
          \uCD94\uC801\uD574\uC11C \uB0B4\uC6A9\uC6A9\uBB3C\uC744 \uD655\uBCF4\uD560
          \uAC83\uC774\uACE0 \uADF8\uB807\uB2E4\uBA74.."
        NextDialogID: S6_04_007
        Type: 2
        SpeakerType: 10
        SpeakerPosType: 2
      - DialogID: S6_04_007
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uBE7C\uB3C4 \uBC15\uB3C4 \uBABB\uD558\uB294 \uAC70\uC9C0\n \uC18C\uC7A5\uC774
          \uB098\uB97C \uB3C8\uC73C\uB85C \uD68C\uB958\uD558\uB824\uD588\uC9C0\uB9CC,
          \uADF8\uB7F0 \uB9AC\uC2A4\uD06C\uB97C \uC9C8 \uD544\uC694\uAC00\uC5C6\uC9C0."
        NextDialogID: S6_04_008
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_008
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC18C\uC7A5\uC774 \uB098\uB97C \uB3C8\uC73C\uB85C \uD68C\uC720\uD558\uB824\uD588\uC9C0\uB9CC,
          \uADF8\uB7F0 \uB9AC\uC2A4\uD06C\uB97C \uC9C8 \uD544\uC694\uAC00\uC5C6\uC9C0.\n
          \uC6B0\uB9B0 \uD3EC\uC0C1\uAE08\uB9CC \uCC59\uAE30\uBA74 \uADF8\uB9CC\uC774\uC57C."
        NextDialogID: S6_04_009
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_04_009
        CharacterName: "\uD54C\uD53C"
        Script: "\uC77C\uB2E8 \uC544\uC9C1 \uB05D\uB09C\uAC8C \uC544\uB2C8\uB2C8
          \uB108\uBB34 \uB4E4\uB5A0\uC788\uC9C0\uB9D0\uACE0\n \uC0AC\uC9C4\uD30C\uC77C\uC740
          \uC5B4\uB514\uC5D0\uC788\uC5B4."
        NextDialogID: S6_04_010
        Type: 2
        SpeakerType: 10
        SpeakerPosType: 2
      - DialogID: S6_04_010
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC77C\uB2E8 \uC6CC\uD06C \uBAA8\uB4C8\uC5D0 \uC800\uC7A5\uD574\uB1A8\uC5B4.\n
          \uC790\uC138\uD55C\uAC74 \uC774\uB530 \uB124\uC774\uC624\uC2A4 \uB3C4\uCC29\uD558\uBA74
          \uC598\uAE30\uD558\uC790"
        NextDialogID: S6_02_011
        Type: 2
        SpeakerType: 2
        SpeakerPosType: 1
      - DialogID: S6_02_011
        CharacterName: "\uD54C\uD53C"
        Script: "\uADF8\uB798 \uC774\uB530\uBCF4\uC790 \uBA40\uBBF8 \uC870\uC2EC\uD558\uACE0"
        NextDialogID: End
        Type: 2
        SpeakerType: 10
        SpeakerPosType: 2
      - DialogID: End
        CharacterName: End
        Script: End
        NextDialogID: End
        Type: 4
        SpeakerType: 0
        SpeakerPosType: 0
