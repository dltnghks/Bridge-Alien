        Type: 1
        SpeakerType: 3
        SpeakerPosType: 1
      - DialogID: P_01_003
        CharacterName: "\uAE40\uC774\uBBFC"
        Script: "\uC5B4\uD734, \uADF8\uB098\uC800\uB098 \uC5EC\uAE30\uAC00 \uC9C0\uAD6C\uAD6C\uB9CC..\n
