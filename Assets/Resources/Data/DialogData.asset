        CharacterName: "\uC2E0\uD300\uC7A5"
        Script: "\uADF8\uB807\uB2E4\uBA74 \uC65C..??"
        NextDialogID: S6_02_005
        Type: 2
        SpeakerType: 4
        SpeakerPosType: 2
      - DialogID: S6_02_005
        CharacterName: "\uC18C\uC7A5"
